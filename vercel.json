{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=43200" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=43200" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.cloudopsync.com" }],
      "destination": "https://cloudopsync.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "devopsservice.vercel.app" }],
      "destination": "https://cloudopsync.com/:path",
      "permanent": true
    },
    { "source": "/devops-consulting", "destination": "/services/devops-consulting", "permanent": true },
    { "source": "/devops-consulting-services", "destination": "/services/devops-consulting", "permanent": true },
    { "source": "/devops-for-startups", "destination": "/services/devops-consulting", "permanent": true },
    { "source": "/platform-engineering-services", "destination": "/services/devops-consulting", "permanent": true },
    { "source": "/ci-cd-consulting", "destination": "/services/cicd-automation", "permanent": true },
    { "source": "/cicd-automation-services", "destination": "/services/cicd-automation", "permanent": true },
    { "source": "/azure-devops-consulting", "destination": "/services/cicd-automation", "permanent": true },
    { "source": "/infrastructure-as-code-services", "destination": "/services/cicd-automation", "permanent": true },
    { "source": "/cloud-infrastructure-services", "destination": "/services/cloud-infrastructure", "permanent": true },
    { "source": "/cloud-computing-services", "destination": "/services/cloud-infrastructure", "permanent": true },
    { "source": "/cloud-consulting-services", "destination": "/services/cloud-infrastructure", "permanent": true },
